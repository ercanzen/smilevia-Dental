# Formular-Zustellung (Web3Forms – kein Bestätigungslink nötig, kostenlos)
# Access Key erstellen unter https://web3forms.com/ (E-Mail eingeben, Key kommt sofort per Mail)
VITE_WEB3FORMS_ACCESS_KEY=deine-access-key-hier

# Google Analytics 4 (Mess-ID aus analytics.google.com → Verwaltung → Datenstreams, Format G-XXXXXXXXXX)
# Leer lassen = kein Tracking, kein Cookie-Banner
VITE_GA_MEASUREMENT_ID=
